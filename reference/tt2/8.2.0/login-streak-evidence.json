  "version": "8.2.0",
  "role": "連續登入天數的傷害加成：指數是天數、底數是加成，漏領一天就整項失效。",
  "packageSha256": "8d78c9aa877e6c0b291ee2116cab855bd26c59c1d080bc654f88ecf1ff268b5f",
  "binarySha256": "c13fc44321b1214c71ab0277a134fc3401fd7392c74a0bbb3935671c55a8713a",
