    "stageSkip": {
      "method": "StageLogic$$GetStageSkip",
      "rva": "0x25448e4",
      "expression": "(StageSkip + 該來源的 StageSkip) × 該來源專屬的 Mult，取整數",
      "apply": {
        "method": "StageLogic$$DoSplashStageSkip",
        "rva": "0x2544724",
        "note": "跳過的每一關走 GetBossSplashGoldDrop 給頭目金幣，並以 GetMonsterCountPerStage 結算跳過的關卡裡的小怪。"
      },
