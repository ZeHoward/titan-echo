{
  "version": "8.2.0",
  "role": "多重泰坦生成：生成骰、一波的隻數、一波的金幣結算，以及原生自己的平均隻數估計。",
  "packageSha256": "8d78c9aa877e6c0b291ee2116cab855bd26c59c1d080bc654f88ecf1ff268b5f",
